//| mill-version: 1.3.1
package build

import mill.*
import mill.scalalib.*
import mill.scalajslib.*

import taxdelta.data.*

object Versions:
  val scala   = "3.3.7"
  val scalaJS = "1.20.1"
  val upickle = "4.3.2"
  val munit   = "1.1.1"
  val laminar = "17.2.1"

/** Common settings for modules that cross-build to the JVM and Scala.js.
 *  Sources: `<module>/src` (shared), `<module>/src-jvm`, `<module>/src-js`. */
trait Shared extends ScalaModule with PlatformScalaModule:
  def scalaVersion = Versions.scala
  def scalacOptions = Seq("-deprecation", "-feature", "-unchecked", "-Wunused:imports")

trait SharedJS extends Shared with ScalaJSModule:
  def scalaJSVersion = Versions.scalaJS

trait SharedTests extends TestModule.Munit:
  def mvnDeps = Seq(mvn"org.scalameta::munit::${Versions.munit}")

def writeFixture(destPath : os.Path, cn : String, rp : String) = os.write(destPath / (cn +".scala"), FixtureSource.fromCsvResource("taxdelta.data",cn,rp).toString())

/** The pure simulation engine. No IO, no reflection: JS-safe. */
object core extends Module:
  def generateWorksheets = Task:
    writeFixture(Task.dest, "Sz2019Worksheet_databig","fixtures/sz2019/databig.csv")
    writeFixture(Task.dest, "Sz2019Worksheet_growth","fixtures/sz2019/growth.csv")
    PathRef(Task.dest)
  /** The workbook's cached outputs, as test oracles only (kept out of the library itself). */
  def generateTestWorksheets = Task:
    writeFixture(Task.dest, "Sz2019Worksheet_calculatorbig","fixtures/sz2019/calculatorbig_expected.csv")
    PathRef(Task.dest)
  object jvm extends Shared:
    override def generatedSources = Task( super.generatedSources() :+ generateWorksheets() )
    object test extends ScalaTests with SharedTests:
      override def generatedSources = Task( super.generatedSources() :+ generateTestWorksheets() )
  object js extends SharedJS:
    override def generatedSources = Task( super.generatedSources() :+ generateWorksheets() )
    object test extends ScalaJSTests with SharedTests:
      override def generatedSources = Task( super.generatedSources() :+ generateTestWorksheets() )

/** Scala sources for the general model's fixtures (mill-build/resources/fixtures/general/<year>/), as written by
 *  the scripts in fixture-generators/ of the private sibling repository saez-zucman-taxdelta-data-sources.
 *  Per year, one object with the cross-country tables (`Fixtures<year>`), and one per country the catalog
 *  marks as supported (`Fixtures<year>_<ISO2>`), all in package taxdelta.general.fixtures, plus `AllFixtures`
 *  listing the years. The types they implement (`YearFixtures`, `CountryFixtures`, `Table`) live in the general
 *  module. */
object GeneralFixtureSources:
  val Package = "taxdelta.general.fixtures"

  /** A Scala string literal, escaped (fixture text includes quotes, non-ASCII letters, and so on). */
  def lit( s : String ) : String =
    val sb = new StringBuilder("\"")
    s.foreach:
      case '"'  => sb ++= "\\\""
      case '\\' => sb ++= "\\\\"
      case '\n' => sb ++= "\\n"
      case '\r' => sb ++= "\\r"
      case '\t' => sb ++= "\\t"
      case ch if ch < ' ' => sb ++= f"\\u${ch.toInt}%04x"
      case ch   => sb += ch
    sb += '"'
    sb.toString

  def table( csv : Csv ) : String =
    def row( r : IndexedSeq[String] ) = r.map(lit).mkString("IndexedSeq(", ", ", ")")
    s"""Table(\n    ${row(csv.header)},\n    IndexedSeq(\n${csv.rows.map("      " + row(_)).mkString(",\n")}\n    )\n  )"""

  def read( p : os.Path ) : Csv = Csv.parse(os.read(p))

  def write( fixtureRoot : os.Path, dest : os.Path ) : Unit =
    val years = os.list(fixtureRoot).filter(os.isDir).map(_.last).filter(_.forall(_.isDigit)).sorted
    for y <- years do
      val dir = fixtureRoot / y
      val catalog = read(dir / "catalog.csv")
      val supported = catalog.rows.indices.filter(i => catalog.value(i, catalog.header.indexOf("individualIncomeTax")) == "yes")
                                          .map(i => catalog.value(i, 0))
      for iso <- supported do
        os.write(dest / s"Fixtures${y}_$iso.scala",
          s"""|package $Package
              |
              |import taxdelta.general.{CountryFixtures, Table}
              |
              |object Fixtures${y}_$iso extends CountryFixtures:
              |  val iso = ${lit(iso)}
              |  lazy val groups : Table = ${table(read(dir / "groups" / s"$iso.csv"))}
              |  lazy val incomeTaxSchedule : Table = ${table(read(dir / "oecd" / "pit" / s"$iso.csv"))}
              |  lazy val notes : Table = ${table(read(dir / "notes" / s"$iso.csv"))}
              |""".stripMargin)
      os.write(dest / s"Fixtures$y.scala",
        s"""|package $Package
            |
            |import taxdelta.general.{CountryFixtures, Table, YearFixtures}
            |
            |object Fixtures$y extends YearFixtures:
            |  val year = $y
            |  lazy val countries : Table = ${table(read(dir / "countries.csv"))}
            |  lazy val catalog : Table = ${table(catalog)}
            |  lazy val individualIncomeTaxBase : Table = ${table(read(dir / "individual-income-tax-base.csv"))}
            |  lazy val byIso : Map[String, CountryFixtures] = Map(
            |${supported.map(iso => s"    ${lit(iso)} -> Fixtures${y}_$iso").mkString(",\n")}
            |  )
            |""".stripMargin)
    os.write(dest / "AllFixtures.scala",
      s"""|package $Package
          |
          |import taxdelta.general.YearFixtures
          |
          |object AllFixtures:
          |  lazy val years : IndexedSeq[YearFixtures] = IndexedSeq(${years.map(y => s"Fixtures$y").mkString(", ")})
          |""".stripMargin)

/** The general (multi-country) model, built on core. Its data are generated from fixtures. */
object general extends Module:
  def fixtureRoot = Task.Source(moduleDir / os.up / "mill-build" / "resources" / "fixtures" / "general")
  def generateFixtures = Task:
    GeneralFixtureSources.write(fixtureRoot().path, Task.dest)
    PathRef(Task.dest)
  object jvm extends Shared:
    override def moduleDeps = Seq(core.jvm)
    override def generatedSources = Task( super.generatedSources() :+ generateFixtures() )
    object test extends ScalaTests with SharedTests
  object js extends SharedJS:
    override def moduleDeps = Seq(core.js)
    override def generatedSources = Task( super.generatedSources() :+ generateFixtures() )
    object test extends ScalaJSTests with SharedTests

/** Demo website for the reworked model: Scala.js + Laminar, static files in `webapp/static`.
 *  A port of the UI in saez-zucman-taxsim-scala, driving `core` through its model contexts.
 *  `./mill webapp.site` assembles the site (optimized JS) in out/webapp/site.dest;
 *  `./mill webapp.devSite` does the same with fast (unoptimized) linking;
 *  `./mill webapp.standalone` writes a single self-contained HTML file;
 *  `./mill webapp.browserTest` runs the end-to-end browser checks (needs Node 22+ and Chrome). */
object webapp extends ScalaJSModule:
  def scalaVersion = Versions.scala
  def scalaJSVersion = Versions.scalaJS
  def scalacOptions = Seq("-deprecation", "-feature", "-unchecked", "-Wunused:imports")
  def moduleDeps = Seq(core.js)
  def mvnDeps = Seq(mvn"com.raquo::laminar::${Versions.laminar}")
  def scalaJSUseMainModuleInitializer = true

  /** Display-only data from the workbook (historical tax rates), kept out of core. */
  def generateDisplayWorksheets = Task:
    writeFixture(Task.dest, "Sz2019Worksheet_history", "fixtures/sz2019/history.csv")
    writeFixture(Task.dest, "Sz2019Worksheet_datahist", "fixtures/sz2019/datahist.csv")
    PathRef(Task.dest)
  override def generatedSources = Task( super.generatedSources() :+ generateDisplayWorksheets() )

  def staticFiles = Task.Source(moduleDir / "static")

  private def assemble(static: os.Path, jsDir: os.Path, out: os.Path): Unit =
    for p <- os.list(static) do os.copy(p, out / p.last, replaceExisting = true)
    os.copy(jsDir / "main.js", out / "main.js", replaceExisting = true)

  def site = Task {
    assemble(staticFiles().path, fullLinkJS().dest.path, Task.dest)
    PathRef(Task.dest)
  }

  def devSite = Task {
    assemble(staticFiles().path, fastLinkJS().dest.path, Task.dest)
    PathRef(Task.dest)
  }

  def browserTest(args: String*) = Task.Command {
    val script = moduleDir / "e2e" / "browser-test.mjs"
    val r = os.proc("node", script, site().path, standalone().path, args)
      .call(stdout = os.Inherit, stderr = os.Inherit, check = false)
    if r.exitCode != 0 then throw new Exception(s"browser tests failed (exit ${r.exitCode})")
  }

  /** index.html with the stylesheet and script inlined, for sharing as one file. */
  def standalone = Task {
    val dir = site().path
    val css = os.read(dir / "styles.css")
    val js = os.read(dir / "main.js").replace("</script", "<\\/script")
    val html = os.read(dir / "index.html")
      .replace("""<link rel="stylesheet" href="styles.css">""", s"<style>\n$css\n</style>")
      .replace("""<script src="main.js"></script>""", s"<script>\n$js\n</script>")
    os.write(Task.dest / "taxsim-demo.html", html)
    PathRef(Task.dest / "taxsim-demo.html")
  }

  val StagingDir = "/Users/swaldman/development/gitproj/www.mchange.com/tmp/saez-zucman-taxdelta"

  def stage = Task {
    val siteDir        = site().path
    val standaloneSite = standalone().path
    val stagingDir = os.Path(StagingDir)

    os.makeDir.all(stagingDir)
    os.copy.over(siteDir,stagingDir)
    os.copy(standaloneSite,stagingDir / "standalone.html", replaceExisting=true)
  }

